# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Database — ALWAYS Port 6543 (Transaction Pooler, NOT 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# App Security
SECRET_KEY=replace_this_with_a_random_32_char_string

# Environment
ENVIRONMENT=development

# ML Model Path (relative to backend root)
ML_MODELS_PATH=../ml/models
